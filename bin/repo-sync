#!/bin/bash

confirm() {
  local msg=$1
  while true; do
    read -p "$msg (Y/n) " -r
    case $REPLY in
      Y | y | "")
        return 0
        ;;
      N | n)
        return 1
        ;;
    esac
  done
}

# -------------------------------------------------

if [[ $1 == . ]]; then
  git fetch --prune
  git status --short
  # repo position versus upstream?
  read -r behind ahead < <(git rev-list --left-right --count "@{u}"...HEAD)
  # no upstream
  if [[ -z $behind ]]; then
    exit 1
  fi
  if [[ $behind -gt 0 ]]; then
    echo
    if confirm "git merge --ff-only?"; then
      git merge --ff-only
    fi
    exit 1
  fi
  # repo not clean?
  if [[ -n "$(git status --porcelain)" || $ahead -gt 0 ]]; then
    exit 1
  fi
  exit
fi

# -------------------------------------------------

# all repos
spec="$(for path in $REPOS; do
  printf 'run -c %s "clear; repo-sync ."\n' "$path"
done)"

tmux.each -x "$@" "$spec"

