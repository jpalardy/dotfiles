#!/bin/bash

keepopen=0

usage() {
  cat >&2 <<EOM
Usage: $(basename "$0") [OPTION]...
  -k          keep open
  -h          display help
EOM
}

while getopts "hkn" opt; do
  case "$opt" in
    k)
      keepopen=1
      ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

if [[ -z "$TMUX" ]]; then
  exec tmux new-session -- "$0" "$@"
fi

# flush
shift $((OPTIND - 1))

# -------------------------------------------------

confirm() {
  local msg=$1
  while true; do
    read -p "$msg (Y/n) " -r
    case $REPLY in
      Y | y | "")
        return 0
        ;;
      N | n)
        return 1
        ;;
    esac
  done
}

# -------------------------------------------------

if [[ -n "$1" ]]; then
  git fetch --prune
  git status --short
  # repo position versus upstream?
  read -r behind ahead < <(git rev-list --left-right --count "@{u}"...HEAD)
  # no upstream
  if [[ -z $behind ]]; then
    exit 1
  fi
  if [[ $behind -gt 0 ]]; then
    echo
    if confirm "git merge --ff-only?"; then
      git merge --ff-only
    fi
    exit 1
  fi
  # repo not clean?
  if [[ -n "$(git status --porcelain)" || $ahead -gt 0 ]]; then
    exit 1
  fi
  exit
fi

# -------------------------------------------------

post=""
[[ $keepopen -eq 0 ]] && post="; and exit"

for repo in $REPOS; do
  printf "run -c %s \"clear; repo-sync .%s\"\n" "$repo" "$post"
done | tmux.each

