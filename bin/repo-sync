#!/bin/bash

dryrun=0

usage() {
  cat >&2 <<EOM
Usage: $(basename "$0") [OPTION]...
  -n          dry-run
  -h          display help
EOM
  # shellcheck disable=SC2086
  exit ${1:-0}
}

while getopts "hn" opt; do
  case "$opt" in
    n)
      # shellcheck disable=SC2034
      dryrun=1
      ;;
    h)
      usage 0
      ;;
    *)
      usage 1
      ;;
  esac
done

# flush
shift $((OPTIND - 1))

# -------------------------------------------------

confirm() {
  local msg=$1
  while true; do
    read -p "$msg (Y/n) " -r
    case $REPLY in
      Y | y | "")
        return 0
        ;;
      N | n)
        return 1
        ;;
    esac
  done
}

# -------------------------------------------------

if [[ -z "$TMUX" && $dryrun -eq 0 ]]; then
  tmux new-session "$0"
  exit
fi

if [[ -n "$1" ]]; then
  git fetch --prune
  git status --short
  # repo behind upstream?
  if [ "$(git rev-list --count "@{u}"...HEAD)" -gt 0 ]; then
    echo
    if confirm "git merge --ff-only?"; then
      git merge --ff-only
    fi
    exit 1
  fi
  # repo not clean?
  if [ -n "$(git status --porcelain)" ]; then
    exit 1
  fi
  exit
fi

# -------------------------------------------------

# dry-run sets the filter
filter="tmux.each"
if [[ $dryrun -eq 1 ]]; then
  filter="cat"
fi

for repo in $REPOS; do
  printf "%s\t%s\t%s\n" "$repo" "clear; repo-sync .; and exit" "$(basename "$repo")"
done | $filter

