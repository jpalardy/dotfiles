#!/bin/bash

usage() {
  cat >&2 <<EOF
usage: ${0##*/} [-n] [-x] [-k] [-h] <SPEC>

options:
  -h  print this help message
  -n  dry-run: only echo SPEC back
  -x  exit window shell if command succeeds
  -k  keep shell open (default/override)

SPEC lines:
  type [-c dir] [-n name] [command...]
  run  [-c dir] [-n name] [command...]

line flags:
  -c  working directory (default: PWD)
  -n  window name (default: basename of dir)
EOF
}

exit_suffix() {
  local sh
  sh=$(tmux show-option -gv default-shell 2>/dev/null)
  sh=${sh:-${SHELL:-sh}}
  case ${sh##*/} in
    fish) printf '; and exit' ;;
    *)    printf ' && exit' ;;
  esac
}

open_window() {
  local mode=$1 dir=$PWD name='' opt cmd win
  shift

  case $mode in
    type|run) ;;
    *) echo >&2 "bad verb '$mode'"; return 2 ;;
  esac

  OPTIND=1
  while getopts c:n: opt; do
    case $opt in
      c) dir=${OPTARG/#\~/$HOME} ;;
      n) name=$OPTARG ;;
      *) usage; return 2 ;;
    esac
  done
  shift $((OPTIND - 1))
  cmd="$*"
  [[ -n $cmd ]] && (( exit_on_success )) && cmd+=$(exit_suffix)

  [[ -f $dir ]] && dir=$(dirname "$dir")
  if [[ ! -d $dir ]]; then
    echo >&2 "skipping: no such dir: $dir"
    return 2
  fi

  win=$(tmux new-window -P -F '#{window_id}' -c "$dir") || return 1
  tmux rename-window -t "$win" "${name:-$(basename "$dir")}" || return 1

  if [[ -n $cmd ]]; then
    tmux send-keys -t "$win" -l "$cmd" </dev/null
    [[ $mode == run ]] && tmux send-keys -t "$win" Enter </dev/null
  fi
  return 0
}

# -------------------------------------------------
# (main)
# -------------------------------------------------

dry_run=0
exit_on_success=0
while getopts nxkh opt; do
  case $opt in
    n) dry_run=1 ;;
    x) exit_on_success=1 ;;
    k) exit_on_success=0 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
flags=("${@:1:OPTIND-1}")
shift $((OPTIND - 1))

# input: arguments win, otherwise STDIN
if (( $# )); then
  input=$(printf '%s\n' "$@")
elif [[ ! -t 0 ]]; then
  input=$(cat)
else
  usage
  exit 1
fi

if (( dry_run )); then
  printf "%s\n" "$input"
  exit 0
fi

if [[ -z $TMUX ]]; then
  exec tmux new-session -- "$0" "${flags[@]}" "$input"
fi

status=0
while IFS= read -r line || [[ -n $line ]]; do
  [[ -z $line ]] && continue
  eval "set -- $line" || { echo >&2 "parse error: $line"; status=1; continue; }
  open_window "$@" || status=1
done <<<"$input"

exit $status
