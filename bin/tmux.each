#!/bin/bash

usage() {
  echo >&2 "usage: <lines> | ${0##*/}"
  echo >&2 "  type [-c dir] [-n name] [command...]"
  echo >&2 "  run  [-c dir] [-n name] [command...]"
}

open_window() {
  local mode=$1 dir=$PWD name='' opt cmd win
  shift

  case $mode in
    type|run) ;;
    *) echo >&2 "bad verb '$mode'"; return 1 ;;
  esac

  OPTIND=1
  while getopts c:n: opt; do
    case $opt in
      c) dir=${OPTARG/#\~/$HOME} ;;
      n) name=$OPTARG ;;
      *) usage; return 2 ;;
    esac
  done
  shift $((OPTIND - 1))
  cmd="$*"

  [[ -f $dir ]] && dir=$(dirname "$dir")
  if [[ ! -d $dir ]]; then
    echo >&2 "skipping: no such dir: $dir"
    return 1
  fi

  win=$(tmux new-window -P -F '#{window_id}' -c "$dir") || return 1
  tmux rename-window -t "$win" "${name:-$(basename "$dir")}" || return 1

  if [[ -n $cmd ]]; then
    tmux send-keys -t "$win" -l "$cmd" </dev/null
    [[ $mode == run ]] && tmux send-keys -t "$win" Enter </dev/null
  fi
  return 0
}

# -------------------------------------------------
# (main)
# -------------------------------------------------

dry_run=0
while getopts n opt; do
  case $opt in
    n) dry_run=1 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if (( $# )) || [[ -t 0 ]]; then
  usage
  exit 1
fi

if (( dry_run )); then
  cat
  exit 0
fi

if [[ -z $TMUX ]]; then
  echo >&2 "need to run inside tmux"
  exit 1
fi

status=0
while IFS= read -r line || [[ -n $line ]]; do
  [[ -z $line || $line == \#* ]] && continue
  eval "set -- $line" || { echo >&2 "parse error: $line"; status=1; continue; }
  open_window "$@" || status=1
done

exit $status
