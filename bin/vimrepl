#!/bin/bash

EDITOR=${EDITOR:-vim}
args=("$@")

usage() {
  cat >&2 <<EOM
Usage: ${EDITOR}repl [OPTIONS] filename

  -h           display help
  -c command   command to execute

  if filename contains "___" it is replaced with "_${EDITOR}repl"

Examples:
  ${EDITOR}repl ___.R
  ${EDITOR}repl report.R
  ${EDITOR}repl -c R ___.R
EOM
}

# -------------------------------------------------

cmd=""
filename=""

while getopts "c:h" opt; do
  case "$opt" in
    c)
      cmd=$OPTARG
      ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

if [[ $# -eq 1 ]]; then
  filename="${1/___/_${EDITOR}repl}"
else
  usage
  exit 1
fi

if [[ -z "$TMUX" ]]; then
  exec tmux new-session -- "$0" "${args[@]}"
fi

# -------------------------------------------------

# split if not already split
if [[ $(tmux list-panes -F'#{window_panes}' | head -n1) -eq 1 ]]; then
  # split pane runs cmd, if given
  tmux split-window -h
  if [[ -n "$cmd" ]]; then
    tmux send-keys "clear; $cmd" C-m
  fi
  # go back to initiating (last) pane
  tmux select-pane -l
fi

# ${EDITOR}...
${EDITOR} "$filename"

# after ${EDITOR}, kill other pane(s)
tmux kill-pane -a

