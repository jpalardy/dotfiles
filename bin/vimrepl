#!/bin/bash

EDITOR=${EDITOR:-vim}
args=("$@")

usage() {
  cat >&2 <<EOM
Usage: ${EDITOR}repl [OPTIONS] [ext]

  -h           display help
  -c command   command to execute
  -f filename  filename to edit
  ext          extension; used if -f is missing

Examples:
  ${EDITOR}repl R
  ${EDITOR}repl -f report.R
EOM
}

# -------------------------------------------------

cmd=""
filename=""

while getopts "c:f:h" opt; do
  case "$opt" in
    c)
      cmd=$OPTARG
      ;;
    f)
      filename=$OPTARG
      ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

shift $((OPTIND - 1))

# grab ext
if [[ -z "$filename" && "$#" -eq 1 ]]; then
  filename="_${EDITOR}repl.$1"
  shift
fi

if test -z "$filename"; then
  usage
  exit 1
fi

if [ -z "$TMUX" ]; then
  exec tmux new-session -- "$0" "${args[@]}"
fi

# -------------------------------------------------

# split if not already split
if [ "$(tmux list-panes -F'#{window_panes}' | head -n1)" -eq 1 ]; then
  # split pane runs cmd, if given
  tmux split-window -h
  if [ -n "$cmd" ]; then
    tmux send-keys "clear; $cmd" C-m
  fi
  # go back to initiating (last) pane
  tmux select-pane -l
fi

# ${EDITOR}...
${EDITOR} "$filename"

# after ${EDITOR}, kill other pane(s)
tmux kill-pane -a

