#!/bin/bash

if ! test "$(command -v pg_format)"; then
  echo "-- pg_format is not installed"
  exit 1
fi


# -------------------------------------------------

awk '

{
  regular_lines++
  sub(";$", "")
  print
}

END {
  if (regular_lines > 0) {
    print ";"
  }
}

' "$@" | pg_format --wrap-after 10 --no-extra-line

