#!/usr/bin/env -S awk -f

BEGIN {
  total_indents = 0
  valid_lines = 0
  max_indent = 0
}

# skip blank lines
NF {
  # count whitespace in front of line
  match($0, /^[ \t]*/)
  indent = RLENGTH
  # indent = length($0) - length(gensub(/^\s*/, "", 1, $0))

  if (indent > max_indent) max_indent = indent
  total_indents += indent
  valid_lines++
}

ENDFILE {
  if (valid_lines > 0) {
    print FILENAME, total_indents, valid_lines, sprintf("%.1f", total_indents / valid_lines), max_indent
  }
  # reset
  total_indents = 0
  valid_lines = 0
  max_indent = 0
}

